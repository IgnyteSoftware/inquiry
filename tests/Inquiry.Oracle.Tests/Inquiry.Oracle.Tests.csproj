<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);INQUIRY_ORACLE_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Xunit.SkippableFact" />
    <ProjectReference Include="..\..\src\Inquiry\Inquiry.csproj" />
    <ProjectReference Include="..\..\src\Inquiry.Oracle\Inquiry.Oracle.csproj" />
    <ProjectReference Include="..\..\src\Inquiry.Testing\Inquiry.Testing.csproj" />
    <ProjectReference Include="..\Inquiry.IntegrationTesting\Inquiry.IntegrationTesting.csproj" />
    <ProjectReference Include="..\Inquiry.Oracle.UnsupportedFixtures\Inquiry.Oracle.UnsupportedFixtures.csproj" />

    <Compile Include="..\..\samples\Inquiry.Northwind\Models\**\*.cs" LinkBase="Northwind\Models" />
    <Compile Include="..\..\samples\Inquiry.Northwind\Stores\**\*.cs" LinkBase="Northwind\Stores" />
    <Compile Include="..\..\samples\Inquiry.Northwind\NorthwindSchema.cs" LinkBase="Northwind" />

    <Compile Include="..\Inquiry.FeatureCatalog\*.cs" LinkBase="FeatureCatalog" />
    <Compile Include="..\Inquiry.FeatureCatalog\Locking\*.cs" LinkBase="FeatureCatalog\Locking" />
    <Compile Include="..\Inquiry.FeatureCatalog\Locking\Probes\*.cs" LinkBase="FeatureCatalog\Locking\Probes" />
    <Compile Include="..\Shared\RowLockScenarios.cs" Link="Shared\RowLockScenarios.cs" />
    <Compile Include="..\Shared\BatchExecutionProbe.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\EagerGridCommandAssertions.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\PagedResultAssertions.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\SmallInListScenarios.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\ManyToManyExtensionAssertions.cs" LinkBase="Shared" />
    <!-- W9 full-text search is NOT supported on Oracle (generator emits INQ035); FullText is excluded. -->
    <!-- <Compile Include="..\Inquiry.FeatureCatalog\FullText\*.cs" LinkBase="FeatureCatalog\FullText" /> -->
    <!-- Native JSON columns: SQL Server keeps its own fixture because its CI image (2022) has no json type. -->
    <Compile Include="..\Inquiry.FeatureCatalog\NativeJson\*.cs" LinkBase="FeatureCatalog\NativeJson" />
    <Compile Include="..\Inquiry.FeatureCatalog\LockingRegression\*.cs" LinkBase="FeatureCatalog\LockingRegression" />
    <Compile Include="..\Shared\RowLockRegressionScenarios.cs" Link="Shared\RowLockRegressionScenarios.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
