<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Xunit.SkippableFact" />
    <ProjectReference Include="..\..\src\Inquiry\Inquiry.csproj" />
    <ProjectReference Include="..\..\src\Inquiry.SqlServer\Inquiry.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Inquiry.Testing\Inquiry.Testing.csproj" />
    <ProjectReference Include="..\Inquiry.IntegrationTesting\Inquiry.IntegrationTesting.csproj" />

    <Compile Include="..\..\samples\Inquiry.Northwind\Models\**\*.cs" LinkBase="Northwind\Models" />
    <Compile Include="..\..\samples\Inquiry.Northwind\Stores\**\*.cs" LinkBase="Northwind\Stores" />
    <Compile Include="..\..\samples\Inquiry.Northwind\NorthwindSchema.cs" LinkBase="Northwind" />

    <Compile Include="..\Inquiry.FeatureCatalog\*.cs" LinkBase="FeatureCatalog" />
    <Compile Include="..\Inquiry.UpdateActionCatalog\*.cs" LinkBase="UpdateActionCatalog" />
    <Compile Include="..\Inquiry.FeatureCatalog\FullText\*.cs" LinkBase="FeatureCatalog\FullText" />
    <Compile Include="..\Shared\BatchExecutionProbe.cs" Link="Shared\BatchExecutionProbe.cs" />
    <Compile Include="..\Shared\EagerGridCommandAssertions.cs" Link="Shared\EagerGridCommandAssertions.cs" />
    <Compile Include="..\Shared\ManyToManyExtensionAssertions.cs" Link="Shared\ManyToManyExtensionAssertions.cs" />
    <Compile Include="..\Shared\BulkCopierConnectionOwnershipAssertions.cs" Link="Shared\BulkCopierConnectionOwnershipAssertions.cs" />
    <ProjectReference Include="..\..\benchmarks\Inquiry.Benchmarks.DLG\Inquiry.Benchmarks.DLG.csproj" />
    <Compile Include="..\..\benchmarks\Inquiry.Benchmarks.SqlServer\Dlg\DlgSetup.cs" LinkBase="Dlg" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The schema evolution sample runs here against the shared container, from the same files as its Runner. -->
  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" />
    <ProjectReference Include="..\..\samples\Inquiry.SchemaEvolution\V1\Inquiry.SchemaEvolution.V1.csproj" />
    <ProjectReference Include="..\..\samples\Inquiry.SchemaEvolution\V2\Inquiry.SchemaEvolution.V2.csproj" />
    <Compile Include="..\..\samples\Inquiry.SchemaEvolution\*.cs" LinkBase="SchemaEvolution" />
    <EmbeddedResource Include="..\..\samples\Inquiry.SchemaEvolution\Scripts\*.sql" LogicalName="Scripts.%(Filename)%(Extension)" />
    <None Include="..\..\samples\Inquiry.SchemaEvolution\expected-output.txt" Link="SchemaEvolution\expected-output.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
