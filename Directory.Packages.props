<Project>
  <!-- Enable transitive pinning so we can override transitive package versions. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="linq2db" Version="6.5.0" />
    <PackageVersion Include="RepoDb" Version="1.15.1" />
    <PackageVersion Include="RepoDb.Sqlite.Microsoft" Version="1.15.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.30" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Oracle.EntityFrameworkCore" Version="8.23.26300" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MariaDb" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.Oracle" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <!-- Transitive pin: SSH.NET is pulled by Testcontainers and fixes GHSA-q939-rpr3-3284
         (CVE-2026-48798), which affects versions through 2025.1.0. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Transitive pin: overrides SQLitePCLRaw.lib.e_sqlite3 2.1.11 (CVE-2025-6965 / GHSA-2m69-gcr7-jv3q)
         pulled by Microsoft.Data.Sqlite / EF Core Sqlite. Remove once those ship a patched SQLitePCLRaw. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
    <PackageVersion Include="System.Data.OleDb" Version="10.0.11" />
    <PackageVersion Include="System.Data.Odbc" Version="10.0.11" />
    <!-- Transitive pin: Microsoft.Data.SqlClient 7.0.3 and Oracle.ManagedDataAccess.Core 23.26.300 pull
         System.Security.Cryptography.Pkcs 8.0.1 / 9.0.13 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Remove
         once both ship against a patched Pkcs. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Build-time tooling (applied via Directory.Build.props) -->
    <!-- Update this intentionally with the analyzer/toolchain policy. Do not put Version on PackageReference. -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <!-- Project-specific versions. These replace per-project VersionOverride, which central package management now rejects. -->
  <!-- The benchmarks build against a newer Roslyn than the generator's compatibility floor. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Inquiry.Benchmarks' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.Contracts' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.MariaDb' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.MySql' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.Oracle' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.PostgreSql' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.SqlServer'">
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- The provider benchmarks compare against the pinned EF Core 8 cohort. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Inquiry.Benchmarks' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.MariaDb' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.MySql' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.Oracle' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.PostgreSql' or '$(MSBuildProjectName)' == 'Inquiry.Benchmarks.SqlServer'">
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <!-- Transitive pinning turns a pinned transitive package into a direct dependency of every package that
       pulls it in, so the hosting versions stay scoped to the projects that reference them. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Inquiry.Aspire'">
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Inquiry.Aspire.Tests'">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <!-- A central entry would pin System.Collections.Immutable for the analyzers too, so only this project gets it. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Inquiry.Benchmarks.Contracts.Tests'">
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.11" />
  </ItemGroup>
</Project>
