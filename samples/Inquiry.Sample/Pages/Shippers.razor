@page "/shippers"
@inject ShipperService ShipperSvc

<h1>Shippers</h1>

<p>
    Shippers is the smallest classic-Northwind table — three columns, IDENTITY-keyed.
    A minimal end-to-end exercise of <code>[InquiryInsert]</code>,
    <code>[InquiryUpdate]</code>, and <code>[InquiryDeleteOneByKey]</code>.
</p>

<EditForm Model="_draft" OnValidSubmit="CreateAsync" class="form-inline">
    <DataAnnotationsValidator />
    <InputText @bind-Value="_draft.CompanyName" placeholder="Company name" class="input" />
    <InputText @bind-Value="_draft.Phone"       placeholder="Phone"        class="input" />
    <button type="submit" class="btn primary">Add</button>
</EditForm>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <table>
        <thead>
            <tr><th>ID</th><th>Company</th><th>Phone</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in _all)
            {
                <tr>
                    <td><code>@s.ShipperID</code></td>
                    <td><InputText @bind-Value="s.CompanyName" class="input" /></td>
                    <td><InputText @bind-Value="s.Phone"       class="input" /></td>
                    <td class="actions">
                        <button class="btn" @onclick="() => UpdateAsync(s)">Save</button>
                        <button class="btn danger" @onclick="() => DeleteAsync(s)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private List<Shipper> _all = new();
    private Shipper _draft = NewDraft();

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        _all = await ShipperSvc.GetAllAsync();
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.CompanyName)) return;
        await ShipperSvc.CreateAsync(_draft);
        _draft = NewDraft();
        await RefreshAsync();
    }

    private async Task UpdateAsync(Shipper shipper)
    {
        await ShipperSvc.UpdateAsync(shipper);
        await RefreshAsync();
    }

    private async Task DeleteAsync(Shipper shipper)
    {
        await ShipperSvc.DeleteAsync(shipper.ShipperID);
        await RefreshAsync();
    }

    private static Shipper NewDraft() => new() { CompanyName = string.Empty };
}
