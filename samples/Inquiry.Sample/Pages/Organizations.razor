@page "/organizations"
@inject OrganizationService OrgService

<h1>Organizations</h1>

<p>Demonstrates <code>[InquiryInsert]</code>, <code>[InquiryUpdate]</code>, and
   <code>[InquiryDeleteOneByKey]</code> through <code>OrganizationService</code>.</p>

<EditForm Model="_draft" OnValidSubmit="CreateAsync" class="form-inline">
    <DataAnnotationsValidator />
    <InputText @bind-Value="_draft.Name" placeholder="New organization" class="input" />
    <InputCheckbox @bind-Value="_draft.IsActive" /> <span>Active</span>
    <button type="submit" class="btn primary">Add</button>
</EditForm>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in _all)
            {
                <tr>
                    <td>
                        <InputText @bind-Value="o.Name" class="input" />
                    </td>
                    <td>
                        <InputCheckbox @bind-Value="o.IsActive" />
                    </td>
                    <td class="actions">
                        <button class="btn" @onclick="() => UpdateAsync(o)">Save</button>
                        <button class="btn danger" @onclick="() => DeleteAsync(o)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private List<Organization> _all = new();
    private Organization _draft = new() { Name = string.Empty, IsActive = true };

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        _all = await OrgService.GetAllAsync();
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.Name)) return;
        _draft.Key = Guid.NewGuid();
        await OrgService.CreateAsync(_draft);
        _draft = new Organization { Name = string.Empty, IsActive = true };
        await RefreshAsync();
    }

    private async Task UpdateAsync(Organization organization)
    {
        await OrgService.UpdateAsync(organization);
        await RefreshAsync();
    }

    private async Task DeleteAsync(Organization organization)
    {
        await OrgService.DeleteAsync(organization.Key);
        await RefreshAsync();
    }
}
