@page "/users"
@inject UserService UserService

<h1>Users</h1>

<p>Lookup-by-email uses <code>[InquirySelectAllByField("Email")]</code>.</p>

<div class="form-inline">
    <InputText @bind-Value="_emailQuery" placeholder="alice@example.com" class="input" />
    <button class="btn primary" @onclick="LookupAsync">Lookup by email</button>
    @if (_lookupResult is not null)
    {
        <span class="result">Found: @_lookupResult.FirstName @_lookupResult.LastName</span>
    }
    else if (_lookupAttempted)
    {
        <span class="result muted">No match.</span>
    }
</div>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <table>
        <thead>
            <tr><th>First</th><th>Last</th><th>Email</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var u in _all)
            {
                <tr>
                    <td><InputText @bind-Value="u.FirstName" class="input" /></td>
                    <td><InputText @bind-Value="u.LastName"  class="input" /></td>
                    <td><InputText @bind-Value="u.Email"     class="input" /></td>
                    <td class="actions">
                        <button class="btn" @onclick="() => UserService.UpdateAsync(u)">Save</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private List<User> _all = new();
    private string _emailQuery = string.Empty;
    private User? _lookupResult;
    private bool _lookupAttempted;

    protected override async Task OnInitializedAsync()
    {
        _all = await UserService.GetAllAsync();
        _loading = false;
    }

    private async Task LookupAsync()
    {
        _lookupAttempted = true;
        _lookupResult = string.IsNullOrWhiteSpace(_emailQuery)
            ? null
            : await UserService.GetByEmailAsync(_emailQuery);
    }
}
