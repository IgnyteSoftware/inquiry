@page "/"
@inject CustomerService Customers
@inject EmployeeService Employees
@inject CatalogService Catalog

<h1>Dashboard</h1>

<p>
    A snapshot of the classic Northwind sample database, mapped through Inquiry and stored in
    SQLite. Each table is rendered from a Blazor page that injects a <em>service</em>, which
    delegates to an Inquiry generated store.
</p>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <section>
        <h2>Customers <span class="count">@_customers.Count</span></h2>
        <table>
            <thead><tr><th>ID</th><th>Company</th><th>Contact</th><th>Country</th></tr></thead>
            <tbody>
                @foreach (var c in _customers)
                {
                    <tr>
                        <td><code>@c.CustomerID</code></td>
                        <td>@c.CompanyName</td>
                        <td>@(c.ContactName ?? "—")</td>
                        <td>@(c.Country ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section>
        <h2>Employees <span class="count">@_employees.Count</span></h2>
        <table>
            <thead><tr><th>Name</th><th>Title</th><th>Hire date</th></tr></thead>
            <tbody>
                @foreach (var e in _employees)
                {
                    <tr>
                        <td>@e.FirstName @e.LastName</td>
                        <td>@(e.Title ?? "—")</td>
                        <td>@(e.HireDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section>
        <h2>Catalog <span class="badge">Eager loaded</span></h2>
        <p class="hint">
            Categories are materialized in one query; each <code>Products</code> collection
            is loaded in a follow-up query and stitched in by the generator.
        </p>
        @foreach (var cat in _catalog)
        {
            var products = cat.Products ?? new List<Product>();
            <details open>
                <summary><strong>@cat.CategoryName</strong> — @products.Count products</summary>
                <ul>
                    @if (products.Count > 0)
                    {
                        foreach (var p in products)
                        {
                            <li>@p.ProductName <span class="muted">$@((p.UnitPrice ?? 0m).ToString("0.00"))</span></li>
                        }
                    }
                    else
                    {
                        <li class="muted">no products</li>
                    }
                </ul>
            </details>
        }
    </section>
}

@code {
    private bool _loading = true;
    private List<Customer> _customers = new();
    private List<Employee> _employees = new();
    private List<Category> _catalog = new();

    protected override async Task OnInitializedAsync()
    {
        _customers = await Customers.GetAllAsync();
        _employees = await Employees.GetAllAsync();
        _catalog = await Catalog.GetCategoriesWithProductsAsync();
        _loading = false;
    }
}
