@page "/customers"
@inject CustomerService CustomerSvc

<h1>Customers</h1>

<p>Demonstrates <code>[InquiryInsert]</code>, <code>[InquiryUpdate]</code>,
   <code>[InquiryDeleteOneByKey]</code>, and lookup-by-country via
   <code>[InquirySelectAllByField("Country")]</code>.</p>

<div class="form-inline">
    <InputText @bind-Value="_countryQuery" placeholder="Germany" class="input" />
    <button class="btn primary" @onclick="LookupAsync">Filter by country</button>
    <button class="btn" @onclick="ClearFilterAsync">Clear filter</button>
</div>

<EditForm Model="_draft" OnValidSubmit="CreateAsync" class="form-inline">
    <DataAnnotationsValidator />
    <InputText @bind-Value="_draft.CustomerID"  placeholder="ID (5 chars)" class="input" />
    <InputText @bind-Value="_draft.CompanyName" placeholder="Company name" class="input" />
    <InputText @bind-Value="_draft.Country"     placeholder="Country"      class="input" />
    <button type="submit" class="btn primary">Add</button>
</EditForm>

@if (_loading)
{
    <p><em>Loading…</em></p>
}
else
{
    <table>
        <thead>
            <tr><th>ID</th><th>Company</th><th>Contact</th><th>Country</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in _all)
            {
                <tr>
                    <td><code>@c.CustomerID</code></td>
                    <td><InputText @bind-Value="c.CompanyName" class="input" /></td>
                    <td><InputText @bind-Value="c.ContactName" class="input" /></td>
                    <td><InputText @bind-Value="c.Country"     class="input" /></td>
                    <td class="actions">
                        <button class="btn" @onclick="() => UpdateAsync(c)">Save</button>
                        <button class="btn danger" @onclick="() => DeleteAsync(c)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private List<Customer> _all = new();
    private Customer _draft = NewDraft();
    private string _countryQuery = string.Empty;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        _all = await CustomerSvc.GetAllAsync();
        _loading = false;
    }

    private async Task LookupAsync()
    {
        if (string.IsNullOrWhiteSpace(_countryQuery)) return;
        _loading = true;
        _all = await CustomerSvc.GetByCountryAsync(_countryQuery);
        _loading = false;
    }

    private Task ClearFilterAsync()
    {
        _countryQuery = string.Empty;
        return RefreshAsync();
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.CustomerID) || string.IsNullOrWhiteSpace(_draft.CompanyName)) return;
        await CustomerSvc.CreateAsync(_draft);
        _draft = NewDraft();
        await RefreshAsync();
    }

    private async Task UpdateAsync(Customer customer)
    {
        await CustomerSvc.UpdateAsync(customer);
        await RefreshAsync();
    }

    private async Task DeleteAsync(Customer customer)
    {
        await CustomerSvc.DeleteAsync(customer.CustomerID);
        await RefreshAsync();
    }

    private static Customer NewDraft() => new() { CustomerID = string.Empty, CompanyName = string.Empty };
}
