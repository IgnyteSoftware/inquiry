{
  "Inquiry": {
    "Provider": "Sqlite"
  },
  // Local-development connection strings only. The SQL Server / PostgreSQL entries carry
  // throwaway local defaults so `dotnet run` works against a default local install — they are
  // NOT real credentials. Override the active provider's connection string with the
  // INQUIRY_SAMPLE_DB environment variable (it takes precedence over the value here) rather
  // than committing real credentials to source control. See README.md.
  "ConnectionStrings": {
    "InquirySample.Sqlite":     "Data Source=northwind.db",
    "InquirySample.SqlServer":  "Server=localhost;Database=InquirySample;Integrated Security=true;TrustServerCertificate=true",
    "InquirySample.PostgreSql": "Host=localhost;Database=inquirysample;Username=postgres;Password=postgres"
  }
}
