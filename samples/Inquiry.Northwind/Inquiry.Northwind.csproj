<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <Description>Inquiry-mapped classic Northwind schema. Shared by the Inquiry sample app and the integration tests so both work against the same realistic dataset.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inquiry\Inquiry.csproj" />
    <!-- Northwind commits its store SQL to the Sqlite dialect (via [assembly: InquiryDialect]
         in AssemblyInfo.cs). The SQL builder for that dialect lives in Inquiry.Sqlite.Analyzer,
         which only gets loaded when something references Inquiry.Sqlite — hence the reference. -->
    <ProjectReference Include="..\..\src\Inquiry.Sqlite\Inquiry.Sqlite.csproj" />
  </ItemGroup>
</Project>
