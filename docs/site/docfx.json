{
  "metadata": [
    {
      "src": [
        {
          "src": "../../src",
          "files": [
            "Inquiry/Inquiry.csproj",
            "Inquiry.Sqlite/Inquiry.Sqlite.csproj",
            "Inquiry.SqlServer/Inquiry.SqlServer.csproj",
            "Inquiry.PostgreSql/Inquiry.PostgreSql.csproj",
            "Inquiry.MySql/Inquiry.MySql.csproj",
            "Inquiry.Oracle/Inquiry.Oracle.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "allowCompilationErrors": false,
      "outputFormat": "mref",
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Inquiry",
      "_appTitle": "Inquiry — compile-time SQL micro-ORM for .NET",
      "_appLogoPath": null,
      "_appFooter": "&copy; Inquiry contributors. Built with <a href='https://dotnet.github.io/docfx'>DocFX</a>.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/JakeOverstreet/inquiry",
        "branch": "main"
      }
    }
  }
}
