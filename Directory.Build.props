<Project>
  <PropertyGroup>
    <!-- Keep these values centralized. Project files should not override them without a documented exception. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <!-- Doc output makes the compiler enforce IDE0005 (unused usings) in the build. CS1591 is
         suppressed by default; packages that ship a public API opt back in per project (see docs/decisions.md).
         1701;1702 are the SDK defaults. The SDK sets them only when NoWarn is empty, and this line runs first. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1701;1702;CS1591</NoWarn>
    <LangVersion Condition="'$(MSBuildProjectExtension)' == '.csproj'">14.0</LangVersion>
    <OptionStrict Condition="'$(MSBuildProjectExtension)' == '.vbproj'">On</OptionStrict>
    <OptionExplicit Condition="'$(MSBuildProjectExtension)' == '.vbproj'">On</OptionExplicit>
    <OptionInfer Condition="'$(MSBuildProjectExtension)' == '.vbproj'">On</OptionInfer>
    <OptionCompare Condition="'$(MSBuildProjectExtension)' == '.vbproj'">Binary</OptionCompare>

    <!-- NuGet audit covers direct and transitive dependencies and reports every severity. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- Restore creates packages.lock.json. CI does not use locked mode, because the lock file records SDK-supplied package versions that change with each .NET patch. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The free SonarAnalyzer packages run during the ordinary build. No SonarScanner or Sonar service is used. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" ExcludeAssets="none" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.vbproj'">
    <PackageReference Include="SonarAnalyzer.VisualBasic" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" ExcludeAssets="none" />
  </ItemGroup>

  <!-- Repository-specific values. -->
  <PropertyGroup>
    <!-- The libraries ship for every supported TFM, including ones the SDK flags as nearing end of life. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- NuGet package metadata -->
    <RepositoryUrl>https://github.com/IgnyteSoftware/inquiry</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/IgnyteSoftware/inquiry</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>micro-orm;source-generator;ado.net;sql</PackageTags>
    <Authors>Ignyte Software Inc.</Authors>
    <Company>Ignyte Software Inc.</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- SourceLink: embed commit metadata so NuGet consumers can step into source -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- MinVer: version derived from nearest git tag (v1.0.0 → 1.0.0) -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
