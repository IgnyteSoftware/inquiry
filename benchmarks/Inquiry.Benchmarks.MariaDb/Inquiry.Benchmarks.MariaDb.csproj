<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <BenchmarkEvidenceProvider>mariadb</BenchmarkEvidenceProvider>
    <BenchmarkEvidenceLane>DeveloperProject</BenchmarkEvidenceLane>
    <BenchmarkEvidenceProviderAssembly>Inquiry.MariaDb</BenchmarkEvidenceProviderAssembly>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Dapper" />
    <!-- Source-generated Dapper. Only methods marked [DapperAot] are intercepted. -->
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="RepoDb" />
    <PackageReference Include="RepoDb.MySqlConnector" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <!-- Design-time only: `dotnet ef dbcontext optimize` generates the compiled model under Ef/CompiledModels. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Testcontainers.MariaDb" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inquiry\Inquiry.csproj" />
    <ProjectReference Include="..\..\src\Inquiry.MariaDb\Inquiry.MariaDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\samples\Inquiry.Northwind\Models\**\*.cs" LinkBase="Northwind\Models" />
    <Compile Include="..\..\samples\Inquiry.Northwind\Stores\**\*.cs" LinkBase="Northwind\Stores" />
    <Compile Include="..\..\samples\Inquiry.Northwind\NorthwindSchema.cs" LinkBase="Northwind" />
    <Compile Include="..\Inquiry.Benchmarks.MySqlFamily\MySqlBatchMutationStrategyRunner.cs" Link="Batch\MySqlBatchMutationStrategyRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 9 generates this [assembly: DbContextModel] file, which makes every MariaDbShipperContext use the
         compiled model. Only the tuned legs may use it, through UseModel, so the plain legs stay plain. -->
    <Compile Remove="Ef\CompiledModels\MariaDbShipperContextAssemblyAttributes.cs" />
  </ItemGroup>

  <Import Project="..\Inquiry.Benchmarks.Contracts\BenchmarkSelectedAssets.targets" />
</Project>
