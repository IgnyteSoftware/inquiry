{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IgnyteSoftware/inquiry/schemas/checked-baseline-v1.json",
  "title": "Inquiry checked benchmark baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaignId", "windowStartUtc", "windowEndUtc", "expectedSampleCount",
    "caseId", "environmentIdentity", "familyIdentity", "familyOrder", "launchSamples",
    "invalidSamples", "familyMembers", "relativeBudget", "absoluteBudget", "comparatorVersion",
    "bootstrapSeed", "approval"
  ],
  "properties": {
    "campaignId": { "type": "string", "minLength": 1 },
    "windowStartUtc": { "type": "string", "format": "date-time" },
    "windowEndUtc": { "type": "string", "format": "date-time" },
    "expectedSampleCount": { "type": "integer", "minimum": 1 },
    "caseId": { "$ref": "#/$defs/hash" },
    "environmentIdentity": { "$ref": "#/$defs/hash" },
    "familyIdentity": { "$ref": "#/$defs/hash" },
    "familyOrder": { "type": "integer", "minimum": 0 },
    "launchSamples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/launchSample" } },
    "invalidSamples": { "type": "array", "items": { "$ref": "#/$defs/invalidSample" } },
    "familyMembers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "relativeBudget": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
    "absoluteBudget": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
    "comparatorVersion": { "type": "string", "minLength": 1 },
    "bootstrapSeed": { "type": "integer", "not": { "const": 0 } },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "launchSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launchIndex", "median"],
      "properties": {
        "launchIndex": { "type": "integer", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 }
      }
    },
    "invalidSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "status", "healthEvidenceHash"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["thermalThrottling", "powerThrottling", "cpuContention", "dockerResourceDrift", "noiseBudgetExceeded"] },
        "healthEvidenceHash": { "$ref": "#/$defs/hash" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commit", "reviewers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/gitCommit" },
        "reviewers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        }
      }
    }
  }
}
