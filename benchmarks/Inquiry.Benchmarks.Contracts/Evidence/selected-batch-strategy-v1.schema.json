{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IgnyteSoftware/inquiry/schemas/selected-batch-strategy-v1.json",
  "title": "Inquiry selected batch strategy manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cardinalities", "providers"],
  "properties": {
    "schemaVersion": { "const": "inquiry-selected-batch-strategy-v1" },
    "cardinalities": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": [1, 10, 100, 1000] }
    },
    "providers": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceReference": {
      "type": "object", "additionalProperties": false,
      "required": ["relativeArtifactId", "sha256", "caseId"],
      "properties": {
        "relativeArtifactId": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "caseId": { "$ref": "#/$defs/hash" }
      }
    },
    "comparisonEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "evidence"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidenceReference" }
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["cardinality", "status", "confidence", "runtimeCapabilities", "selectedEvidence", "comparisonEvidence"],
      "properties": {
        "cardinality": { "enum": [1, 10, 100, 1000] },
        "status": { "enum": ["pendingMeasurement", "provisional", "accepted"] },
        "confidence": { "enum": ["unmeasured", "diagnostic", "authoritative"] },
        "runtimeCapabilities": {
          "oneOf": [
            {
              "type": "object", "minProperties": 1,
              "propertyNames": { "type": "string", "minLength": 1 },
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            { "type": "null" }
          ]
        },
        "selectedEvidence": {
          "oneOf": [{ "$ref": "#/$defs/evidenceReference" }, { "type": "null" }]
        },
        "comparisonEvidence": {
          "type": "array", "items": { "$ref": "#/$defs/comparisonEvidence" }
        }
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "role", "capabilityId"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["directDriver", "directDriverFloor", "precomputedTransportFloor", "endToEnd", "nativeTransport", "alternativeTransport", "control"]
        },
        "capabilityId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "probeMember", "supportedExecutionMode", "fallbackExecutionMode", "affectedMethods"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "probeMember": { "type": "string", "minLength": 1 },
        "supportedExecutionMode": { "type": "string", "minLength": 1 },
        "fallbackExecutionMode": { "type": "string", "minLength": 1 },
        "affectedMethods": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "benchmarkCategory", "selectedMethod", "productionExecutionMode", "sqlShape", "chunkPolicy", "comparisons", "cells"],
      "properties": {
        "operation": { "enum": ["insert", "update", "delete"] },
        "benchmarkCategory": { "type": "string", "minLength": 1 },
        "selectedMethod": { "type": "string", "minLength": 1 },
        "productionExecutionMode": { "type": "string", "minLength": 1 },
        "sqlShape": { "type": "string", "minLength": 1 },
        "chunkPolicy": { "type": "string", "minLength": 1 },
        "comparisons": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/comparison" }
        },
        "cells": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": { "$ref": "#/$defs/cell" }
        }
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "benchmarkAssembly", "benchmarkType", "provisional", "capabilities", "operations"],
      "properties": {
        "provider": { "enum": ["sqlite", "sqlserver", "postgresql", "mysql", "mariadb", "oracle"] },
        "benchmarkAssembly": { "type": "string", "minLength": 1 },
        "benchmarkType": { "type": "string", "minLength": 1 },
        "provisional": { "type": "boolean" },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "operations": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    }
  }
}
