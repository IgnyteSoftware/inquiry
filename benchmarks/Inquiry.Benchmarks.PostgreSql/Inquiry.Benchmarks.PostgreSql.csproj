<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <BenchmarkEvidenceProvider>postgresql</BenchmarkEvidenceProvider>
    <BenchmarkEvidenceLane>DeveloperProject</BenchmarkEvidenceLane>
    <BenchmarkEvidenceProviderAssembly>Inquiry.PostgreSql</BenchmarkEvidenceProviderAssembly>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BenchmarkDotNet requires Release-mode binaries. The csproj defaults stay in Debug; -->
    <!-- pass `-c Release` when running. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Dapper" />
    <!-- Source-generated Dapper. Only methods marked [DapperAot] are intercepted. -->
    <PackageReference Include="Dapper.AOT" />
    <PackageReference Include="linq2db" />
    <PackageReference Include="RepoDb" />
    <PackageReference Include="RepoDb.PostgreSql" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time only: `dotnet ef dbcontext optimize` generates the compiled model under Ef/CompiledModels. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- INQ014: exactly ONE dialect runtime per compilation. -->
    <ProjectReference Include="..\Inquiry.Benchmarks.Contracts\Inquiry.Benchmarks.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Inquiry\Inquiry.csproj" />
    <ProjectReference Include="..\..\src\Inquiry.PostgreSql\Inquiry.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link-compile the Northwind source so the generator emits the PostgreSql store.
         Do NOT ProjectReference Inquiry.Northwind — it is Sqlite-pinned (INQ014). -->
    <Compile Include="..\..\samples\Inquiry.Northwind\Models\**\*.cs" LinkBase="Northwind\Models" />
    <Compile Include="..\..\samples\Inquiry.Northwind\Stores\**\*.cs" LinkBase="Northwind\Stores" />
    <Compile Include="..\..\samples\Inquiry.Northwind\NorthwindSchema.cs" LinkBase="Northwind" />
    <Compile Include="..\Inquiry.Benchmarks.ProcessColdStart\ProcessColdStartRunner.cs" Link="ColdStart\ProcessColdStartRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 9 generates this [assembly: DbContextModel] file, which makes every PgShipperContext use the
         compiled model. Only the tuned legs may use it, through UseModel, so the plain legs stay plain. -->
    <Compile Remove="Ef\CompiledModels\PgShipperContextAssemblyAttributes.cs" />
  </ItemGroup>

  <Import Project="..\Inquiry.Benchmarks.Contracts\BenchmarkSelectedAssets.targets" />
</Project>
