<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <BenchmarkEvidenceProvider>postgresql</BenchmarkEvidenceProvider>
    <BenchmarkEvidenceLane>DeveloperProject</BenchmarkEvidenceLane>
    <BenchmarkEvidenceProviderAssembly>Inquiry.PostgreSql</BenchmarkEvidenceProviderAssembly>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BenchmarkDotNet requires Release-mode binaries. The csproj defaults stay in Debug; -->
    <!-- pass `-c Release` when running. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- EF Core 8.x pulls in M.E.DependencyInjection 8.0.1 transitively; override the
         central package version (6.0.1, picked for the library's netstandard2.0 surface)
         locally so NuGet does not flag a downgrade. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- INQ014: exactly ONE dialect runtime per compilation. -->
    <ProjectReference Include="..\Inquiry.Benchmarks.Contracts\Inquiry.Benchmarks.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Inquiry\Inquiry.csproj" />
    <ProjectReference Include="..\..\src\Inquiry.PostgreSql\Inquiry.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link-compile the Northwind source so the generator emits the PostgreSql store.
         Do NOT ProjectReference Inquiry.Northwind — it is Sqlite-pinned (INQ014). -->
    <Compile Include="..\..\samples\Inquiry.Northwind\Models\**\*.cs" LinkBase="Northwind\Models" />
    <Compile Include="..\..\samples\Inquiry.Northwind\Stores\**\*.cs" LinkBase="Northwind\Stores" />
    <Compile Include="..\..\samples\Inquiry.Northwind\NorthwindSchema.cs" LinkBase="Northwind" />
  </ItemGroup>

  <Import Project="..\Inquiry.Benchmarks.Contracts\BenchmarkSelectedAssets.targets" />
</Project>
