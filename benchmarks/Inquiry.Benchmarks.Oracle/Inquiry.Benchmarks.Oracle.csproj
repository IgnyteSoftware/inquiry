<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <BenchmarkEvidenceProvider>oracle</BenchmarkEvidenceProvider>
    <BenchmarkEvidenceLane>DeveloperProject</BenchmarkEvidenceLane>
    <BenchmarkEvidenceProviderAssembly>Inquiry.Oracle</BenchmarkEvidenceProviderAssembly>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BenchmarkDotNet requires Release-mode binaries. The csproj defaults stay in Debug; -->
    <!-- pass `-c Release` when running. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- This benchmark link-compiles the provider-neutral Northwind stores, including three
         generated-key upserts that Oracle intentionally cannot implement. Suppressing INQ039 at
         project scope opts those unused benchmark methods into compile-safe throwing stubs. -->
    <NoWarn>$(NoWarn);INQ039</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Oracle.EntityFrameworkCore" />
    <PackageReference Include="Testcontainers.Oracle" />
    <!-- EF Core 8.x pulls in M.E.DependencyInjection 8.0.1 transitively; override the
         central package version (6.0.1, picked for the library's netstandard2.0 surface)
         locally so NuGet does not flag a downgrade. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- INQ014: exactly ONE dialect runtime per compilation. -->
    <ProjectReference Include="..\..\src\Inquiry\Inquiry.csproj" />
    <ProjectReference Include="..\..\src\Inquiry.Oracle\Inquiry.Oracle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link-compile the Northwind source so the generator emits the Oracle store.
         Do NOT ProjectReference Inquiry.Northwind — it is Sqlite-pinned (INQ014). -->
    <Compile Include="..\..\samples\Inquiry.Northwind\Models\**\*.cs" LinkBase="Northwind\Models" />
    <Compile Include="..\..\samples\Inquiry.Northwind\Stores\**\*.cs" LinkBase="Northwind\Stores" />
    <Compile Include="..\..\samples\Inquiry.Northwind\NorthwindSchema.cs" LinkBase="Northwind" />
  </ItemGroup>

  <Import Project="..\Inquiry.Benchmarks.Contracts\BenchmarkSelectedAssets.targets" />
</Project>
