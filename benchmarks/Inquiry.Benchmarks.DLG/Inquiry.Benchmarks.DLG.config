<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="Test" connectionString="Server=localhost;Database=Northwind;Integrated Security=True;Min Pool Size=1;Max Pool Size=1;TrustServerCertificate=True;Load Balance Timeout=15" providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="ConnectionStringToUse" value ="Test"/>
		<add key="BackupConnectionStringToUse" value ="BackupDevelopment"/>
		<add key="ShouldUseBackupServer" value ="false"/>
	</appSettings>
</configuration>
			
