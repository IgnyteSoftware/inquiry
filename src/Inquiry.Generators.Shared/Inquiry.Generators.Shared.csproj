<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Description>Shared compile-time framework for the Inquiry source generator. Consumed by each per-provider analyzer package (Inquiry.Sqlite.Analyzer, Inquiry.SqlServer.Analyzer, Inquiry.PostgreSql.Analyzer); not loaded directly by Roslyn.</Description>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Embedded debug info: the analyzer DLLs ship inside provider packages under analyzers/dotnet/cs, where a loose PDB cannot ride in the snupkg (nuget.org symbol validation requires every snupkg PDB to match a lib/ DLL). Embedding keeps the symbols and SourceLink with the assembly itself. -->
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);RS1032;RS1036</NoWarn>
    <!-- Microsoft.CodeAnalysis.Analyzers auto-adds AnalyzerReleases.*.md as AdditionalFiles. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
