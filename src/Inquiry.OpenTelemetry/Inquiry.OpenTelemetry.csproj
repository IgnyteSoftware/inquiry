<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Inquiry.OpenTelemetry</PackageId>
    <Title>Inquiry.OpenTelemetry</Title>
    <Authors>Jake Overstreet</Authors>
    <Description>Optional OpenTelemetry-compatible tracing and metrics instrumentation for Inquiry.</Description>
    <PackageTags>database;ado.net;orm;opentelemetry;metrics;tracing;micro-orm</PackageTags>
    <RepositoryUrl>https://github.com/JakeOverstreet/inquiry</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inquiry\Inquiry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
