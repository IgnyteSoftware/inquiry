<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Description>Compile-time PostgreSQL SQL generator for Inquiry. Self-contained Roslyn analyzer: bundles a private copy of the shared generator framework (Inquiry.Generators.Shared) so Roslyn's per-assembly load-context isolation doesn't fragment the runtime types.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Embedded debug info: the analyzer DLLs ship inside provider packages under analyzers/dotnet/cs, where a loose PDB cannot ride in the snupkg (nuget.org symbol validation requires every snupkg PDB to match a lib/ DLL). Embedding keeps the symbols and SourceLink with the assembly itself. -->
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);RS1032;RS1036</NoWarn>
    <!-- Microsoft.CodeAnalysis.Analyzers auto-adds AnalyzerReleases.*.md as AdditionalFiles. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <ProjectReference Include="..\Inquiry.Generators.Shared\Inquiry.Generators.Shared.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
