<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Description>Provider-neutral Aspire client integration for Inquiry telemetry and health checks. Use it through an Ignyte.Inquiry.Aspire.* provider package.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inquiry\Inquiry.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Inquiry.Aspire.MariaDb" />
    <InternalsVisibleTo Include="Inquiry.Aspire.MySql" />
    <InternalsVisibleTo Include="Inquiry.Aspire.Oracle" />
    <InternalsVisibleTo Include="Inquiry.Aspire.PostgreSql" />
    <InternalsVisibleTo Include="Inquiry.Aspire.Sqlite" />
    <InternalsVisibleTo Include="Inquiry.Aspire.SqlServer" />
  </ItemGroup>
</Project>
