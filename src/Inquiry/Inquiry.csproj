<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>Core abstractions and attributes for the Inquiry source-generated micro-ORM. Reference an Inquiry provider package to enable compile-time store generation for SQLite, SQL Server, PostgreSQL, MySQL, MariaDB, or Oracle.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Runs the trim/AOT analyzers and stamps the trimming/AOT-compatibility metadata. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- The full package (not .Abstractions): IHealthChecksBuilder lives here. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Inquiry.Tests" />
    <InternalsVisibleTo Include="Inquiry.Benchmarks" />
    <InternalsVisibleTo Include="Inquiry.Sqlite" />
    <InternalsVisibleTo Include="Inquiry.Sqlite.Tests" />
    <InternalsVisibleTo Include="Inquiry.SqlServer" />
    <InternalsVisibleTo Include="Inquiry.SqlServer.Tests" />
    <InternalsVisibleTo Include="Inquiry.PostgreSql" />
    <InternalsVisibleTo Include="Inquiry.PostgreSql.Tests" />
    <InternalsVisibleTo Include="Inquiry.MySql" />
    <InternalsVisibleTo Include="Inquiry.MySql.Tests" />
    <InternalsVisibleTo Include="Inquiry.MariaDb" />
    <InternalsVisibleTo Include="Inquiry.MariaDb.Tests" />
    <InternalsVisibleTo Include="Inquiry.Oracle" />
    <InternalsVisibleTo Include="Inquiry.Oracle.Tests" />
  </ItemGroup>
</Project>
