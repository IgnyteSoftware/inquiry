<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>Core abstractions and attributes for the Inquiry source-generated micro-ORM. Reference one of the Inquiry.* provider packages (Inquiry.Sqlite, Inquiry.SqlServer, Inquiry.PostgreSql) to enable code generation.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Inquiry.Tests" />
  </ItemGroup>
</Project>
