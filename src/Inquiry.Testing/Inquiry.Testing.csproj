<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>Test helpers for the Inquiry source-generated micro-ORM: an in-memory SQLite fixture, a recording command interceptor, and a Respawn-based database reset wrapper. Test-framework-agnostic.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inquiry\Inquiry.csproj" />
    <ProjectReference Include="..\Inquiry.Sqlite\Inquiry.Sqlite.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Respawn 6.x transitively references an old Microsoft.Data.SqlClient whose dependency
         chain (Azure.Identity 1.3.0, System.Drawing.Common 5.0.0) carries known CVEs and fails
         the NuGet audit under warnings-as-errors. Reference the centrally-pinned modern client
         directly to lift the whole chain. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Respawn" />
  </ItemGroup>
</Project>
