<Project>
  <!-- Directory.Build.targets is imported after the project file, so these values cannot be quietly disabled by project properties. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <LangVersion Condition="'$(MSBuildProjectExtension)' == '.csproj'">14.0</LangVersion>
    <OptionStrict Condition="'$(MSBuildProjectExtension)' == '.vbproj'">On</OptionStrict>
    <OptionExplicit Condition="'$(MSBuildProjectExtension)' == '.vbproj'">On</OptionExplicit>
    <OptionInfer Condition="'$(MSBuildProjectExtension)' == '.vbproj'">On</OptionInfer>
    <OptionCompare Condition="'$(MSBuildProjectExtension)' == '.vbproj'">Binary</OptionCompare>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Test names such as Method_Scenario_Expected are the convention, so CA1707 does not apply to test projects.
       Microsoft.Testing.Platform apps can set IsTestingPlatformApplication without IsTestProject.
       Benchmark method names appear in results and baselines, so *.Benchmarks projects are exempt too. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' or '$(IsTestingPlatformApplication)' == 'true' or $(MSBuildProjectName.Contains('.Benchmarks'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true' or '@(PackageReference->WithMetadataValue('Identity', 'Microsoft.NET.Test.Sdk'))' != ''">
    <PackageReference Update="coverlet.collector" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" ExcludeAssets="none" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" ExcludeAssets="none" Condition="'@(PackageReference->WithMetadataValue('Identity', 'coverlet.collector'))' == ''" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Update="SonarAnalyzer.CSharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" ExcludeAssets="none" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.vbproj'">
    <PackageReference Update="SonarAnalyzer.VisualBasic" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" ExcludeAssets="none" />
  </ItemGroup>

  <Target Name="ValidateIgnyteBuildPolicy" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(Nullable)' != 'enable'" Text="Ignyte policy requires Nullable=enable. Add a documented exception before changing it." />
    <Error Condition="'$(ImplicitUsings)' != 'enable'" Text="Ignyte policy requires ImplicitUsings=enable. Add a documented exception before changing it." />
    <Error Condition="'$(TreatWarningsAsErrors)' != 'true'" Text="Ignyte policy requires TreatWarningsAsErrors=true." />
    <Error Condition="'$(CodeAnalysisTreatWarningsAsErrors)' != 'true'" Text="Ignyte policy requires CodeAnalysisTreatWarningsAsErrors=true." />
    <Error Condition="'$(EnableNETAnalyzers)' != 'true'" Text="Ignyte policy requires EnableNETAnalyzers=true." />
    <Error Condition="'$(EnforceCodeStyleInBuild)' != 'true'" Text="Ignyte policy requires EnforceCodeStyleInBuild=true." />
    <Error Condition="'$(Deterministic)' != 'true'" Text="Ignyte policy requires Deterministic=true." />
    <Error Condition="'$(ManagePackageVersionsCentrally)' != 'true'" Text="Ignyte policy requires central package management." />
    <Error Condition="'$(CentralPackageVersionOverrideEnabled)' != 'false'" Text="Ignyte policy does not permit central package version overrides." />
    <Error Condition="'$(NuGetAudit)' != 'true'" Text="Ignyte policy requires NuGetAudit=true." />
    <Error Condition="'$(NuGetAuditMode)' != 'all'" Text="Ignyte policy requires NuGetAuditMode=all." />
    <Error Condition="'$(WarningsNotAsErrors)' != ''" Text="Ignyte policy does not permit WarningsNotAsErrors." />
    <Error Condition="'$(MSBuildProjectExtension)' == '.csproj' and '@(PackageReference->WithMetadataValue('Identity', 'SonarAnalyzer.CSharp'))' == ''" Text="Ignyte policy requires SonarAnalyzer.CSharp for C# projects." />
    <Error Condition="'$(MSBuildProjectExtension)' == '.csproj' and '@(PackageReference->WithMetadataValue('Identity', 'SonarAnalyzer.CSharp')->WithMetadataValue('PrivateAssets', 'all')->WithMetadataValue('IncludeAssets', 'runtime; build; native; contentfiles; analyzers; buildtransitive')->WithMetadataValue('ExcludeAssets', 'none'))' == ''" Text="Ignyte policy requires SonarAnalyzer.CSharp analyzer assets to remain enabled and private." />
    <Error Condition="'$(MSBuildProjectExtension)' == '.vbproj' and '@(PackageReference->WithMetadataValue('Identity', 'SonarAnalyzer.VisualBasic'))' == ''" Text="Ignyte policy requires SonarAnalyzer.VisualBasic for Visual Basic projects." />
    <Error Condition="'$(MSBuildProjectExtension)' == '.vbproj' and '@(PackageReference->WithMetadataValue('Identity', 'SonarAnalyzer.VisualBasic')->WithMetadataValue('PrivateAssets', 'all')->WithMetadataValue('IncludeAssets', 'runtime; build; native; contentfiles; analyzers; buildtransitive')->WithMetadataValue('ExcludeAssets', 'none'))' == ''" Text="Ignyte policy requires SonarAnalyzer.VisualBasic analyzer assets to remain enabled and private." />

    <ItemGroup>
      <_IgnyteSuppressedPackageReference Include="@(PackageReference)" Condition="'%(PackageReference.NoWarn)' != '' or '%(PackageReference.WarningsNotAsErrors)' != ''" />
      <_IgnyteNuGetAuditSuppression Include="@(NuGetAuditSuppress)" />
    </ItemGroup>
    <Error Condition="'@(_IgnyteSuppressedPackageReference)' != ''" Text="Ignyte policy does not permit warning suppression metadata on PackageReference items." />
    <Error Condition="'@(_IgnyteNuGetAuditSuppression)' != ''" Text="Ignyte policy does not permit NuGetAuditSuppress items." />
  </Target>

  <!-- Repository-specific provider analyzer wiring. -->
  <PropertyGroup>
    <_InquirySqliteProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.Sqlite\Inquiry.Sqlite.csproj'))</_InquirySqliteProjectPath>
    <_InquirySqliteAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.Sqlite.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.Sqlite.Analyzer.dll'))</_InquirySqliteAnalyzerPath>
    <_InquirySqliteSharedPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.Sqlite.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.Generators.Shared.dll'))</_InquirySqliteSharedPath>

    <_InquirySqlServerProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.SqlServer\Inquiry.SqlServer.csproj'))</_InquirySqlServerProjectPath>
    <_InquirySqlServerAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.SqlServer.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.SqlServer.Analyzer.dll'))</_InquirySqlServerAnalyzerPath>
    <_InquirySqlServerSharedPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.SqlServer.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.Generators.Shared.dll'))</_InquirySqlServerSharedPath>

    <_InquiryPostgreSqlProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.PostgreSql\Inquiry.PostgreSql.csproj'))</_InquiryPostgreSqlProjectPath>
    <_InquiryPostgreSqlAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.PostgreSql.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.PostgreSql.Analyzer.dll'))</_InquiryPostgreSqlAnalyzerPath>
    <_InquiryPostgreSqlSharedPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.PostgreSql.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.Generators.Shared.dll'))</_InquiryPostgreSqlSharedPath>

    <_InquiryMySqlProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.MySql\Inquiry.MySql.csproj'))</_InquiryMySqlProjectPath>
    <_InquiryMySqlAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.MySql.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.MySql.Analyzer.dll'))</_InquiryMySqlAnalyzerPath>
    <_InquiryMySqlSharedPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.MySql.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.Generators.Shared.dll'))</_InquiryMySqlSharedPath>

    <_InquiryMariaDbProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.MariaDb\Inquiry.MariaDb.csproj'))</_InquiryMariaDbProjectPath>
    <_InquiryMariaDbAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.MariaDb.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.MariaDb.Analyzer.dll'))</_InquiryMariaDbAnalyzerPath>
    <_InquiryMariaDbSharedPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.MariaDb.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.Generators.Shared.dll'))</_InquiryMariaDbSharedPath>

    <_InquiryOracleProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.Oracle\Inquiry.Oracle.csproj'))</_InquiryOracleProjectPath>
    <_InquiryOracleAnalyzerPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.Oracle.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.Oracle.Analyzer.dll'))</_InquiryOracleAnalyzerPath>
    <_InquiryOracleSharedPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)src\Inquiry.Oracle.Analyzer\bin\$(Configuration)\netstandard2.0\Inquiry.Generators.Shared.dll'))</_InquiryOracleSharedPath>
  </PropertyGroup>

  <!-- DocFX forces TargetFramework=net8.0 on every project it loads, including the netstandard2.0
       analyzer projects that providers reference only to build them first. Those references add no
       public API, and loading them under the forced TFM makes DocFX warn about the shared generator
       reference, so API metadata generation drops them. -->
  <ItemGroup Condition="'$(InquiryApiMetadata)' == 'true'">
    <ProjectReference Remove="@(ProjectReference->WithMetadataValue('ReferenceOutputAssembly', 'false'))" />
  </ItemGroup>

  <!-- Roslyn analyzer auto-flow only attaches IsRoslynComponent project references one level deep,
       so we manually attach each provider's analyzer (and the shared framework DLL it depends on)
       for any project that references that provider's runtime package. Inside each provider's
       NuGet, both DLLs ship side-by-side under analyzers/dotnet/cs/; we mirror that here for
       project-reference dev builds so the load-context Roslyn picks contains both. -->
  <Target Name="AddInquiryProjectReferenceAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_InquirySqliteProjectReference Include="@(ProjectReference)" Condition="'%(FullPath)' == '$(_InquirySqliteProjectPath)'" />
      <Analyzer Include="$(_InquirySqliteAnalyzerPath)" Condition="'@(_InquirySqliteProjectReference)' != '' and Exists('$(_InquirySqliteAnalyzerPath)')" />
      <Analyzer Include="$(_InquirySqliteSharedPath)" Condition="'@(_InquirySqliteProjectReference)' != '' and Exists('$(_InquirySqliteSharedPath)')" />

      <_InquirySqlServerProjectReference Include="@(ProjectReference)" Condition="'%(FullPath)' == '$(_InquirySqlServerProjectPath)'" />
      <Analyzer Include="$(_InquirySqlServerAnalyzerPath)" Condition="'@(_InquirySqlServerProjectReference)' != '' and Exists('$(_InquirySqlServerAnalyzerPath)')" />
      <Analyzer Include="$(_InquirySqlServerSharedPath)" Condition="'@(_InquirySqlServerProjectReference)' != '' and Exists('$(_InquirySqlServerSharedPath)')" />

      <_InquiryPostgreSqlProjectReference Include="@(ProjectReference)" Condition="'%(FullPath)' == '$(_InquiryPostgreSqlProjectPath)'" />
      <Analyzer Include="$(_InquiryPostgreSqlAnalyzerPath)" Condition="'@(_InquiryPostgreSqlProjectReference)' != '' and Exists('$(_InquiryPostgreSqlAnalyzerPath)')" />
      <Analyzer Include="$(_InquiryPostgreSqlSharedPath)" Condition="'@(_InquiryPostgreSqlProjectReference)' != '' and Exists('$(_InquiryPostgreSqlSharedPath)')" />

      <_InquiryMySqlProjectReference Include="@(ProjectReference)" Condition="'%(FullPath)' == '$(_InquiryMySqlProjectPath)'" />
      <Analyzer Include="$(_InquiryMySqlAnalyzerPath)" Condition="'@(_InquiryMySqlProjectReference)' != '' and Exists('$(_InquiryMySqlAnalyzerPath)')" />
      <Analyzer Include="$(_InquiryMySqlSharedPath)" Condition="'@(_InquiryMySqlProjectReference)' != '' and Exists('$(_InquiryMySqlSharedPath)')" />

      <_InquiryMariaDbProjectReference Include="@(ProjectReference)" Condition="'%(FullPath)' == '$(_InquiryMariaDbProjectPath)'" />
      <Analyzer Include="$(_InquiryMariaDbAnalyzerPath)" Condition="'@(_InquiryMariaDbProjectReference)' != '' and Exists('$(_InquiryMariaDbAnalyzerPath)')" />
      <Analyzer Include="$(_InquiryMariaDbSharedPath)" Condition="'@(_InquiryMariaDbProjectReference)' != '' and Exists('$(_InquiryMariaDbSharedPath)')" />

      <_InquiryOracleProjectReference Include="@(ProjectReference)" Condition="'%(FullPath)' == '$(_InquiryOracleProjectPath)'" />
      <Analyzer Include="$(_InquiryOracleAnalyzerPath)" Condition="'@(_InquiryOracleProjectReference)' != '' and Exists('$(_InquiryOracleAnalyzerPath)')" />
      <Analyzer Include="$(_InquiryOracleSharedPath)" Condition="'@(_InquiryOracleProjectReference)' != '' and Exists('$(_InquiryOracleSharedPath)')" />
    </ItemGroup>
  </Target>
</Project>
